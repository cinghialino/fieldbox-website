{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieldbox-crew01-forms",
  "account_id": "3150c25c779d93bbff275ed7cb3d4b8d",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "forms.fieldbox.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "TESTFLIGHT_DB",
      "database_name": "fieldbox-testflight",
      "database_id": "e7024b40-e053-4709-9675-a09b9cea40fd",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "TESTFLIGHT_EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
